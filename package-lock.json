{
  "name": "gatewaymux-workspace",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "gatewaymux-workspace",
      "version": "0.1.0",
      "license": "MIT",
      "workspaces": [
        "dashboard",
        "sync-server",
        "packaging/npm"
      ]
    },
    "dashboard": {
      "name": "@gatewaymux/dashboard",
      "version": "0.1.0",
      "license": "MIT"
    },
    "node_modules/@gatewaymux/dashboard": {
      "resolved": "dashboard",
      "link": true
    },
    "node_modules/@gatewaymux/sync-server": {
      "resolved": "sync-server",
      "link": true
    },
    "node_modules/gatewaymux": {
      "resolved": "packaging/npm",
      "link": true
    },
    "packaging/npm": {
      "name": "gatewaymux",
      "version": "0.1.0",
      "cpu": [
        "x64"
      ],
      "license": "MIT",
      "os": [
        "win32"
      ],
      "bin": {
        "gatewaymux": "bin/gatewaymux.js"
      }
    },
    "sync-server": {
      "name": "@gatewaymux/sync-server",
      "version": "0.1.0",
      "license": "MIT"
    }
  }
}
